# Optional Environment Variables for Maa Ambika Sweets
# Note: The website is completely static-first and requires no mandatory environment variables or paid backends.

# Canonical Domain URL (used for SEO sitemaps and Open Graph tags)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional Google Maps API Key (if you wish to upgrade from standard iframe embed to Maps JS API in future)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
